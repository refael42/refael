# ─── SiteFlow configuration ────────────────────────────────────────────
# Leave the Supabase values empty to run in DEMO mode (in-memory data,
# persona login, everything works with zero setup).

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (server only). Without it a deterministic local parser is used.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Shared secret for the reminders cron endpoint (/api/cron/tick)
CRON_SECRET=

# Web push (generate with: npm run gen:vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Hours without a reply before a "no response" reminder
# NO_RESPONSE_HOURS=6

# Demo mode: set to 0 to keep demo data in memory only (no .data/demo-db.json)
# SITEFLOW_DEMO_PERSIST=1

{
  "name": "skyport",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.22",
    "expo-localization": "~58.0.5",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@expo/metro-runtime": "^58.0.16",
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "postinstall": "node scripts/copy-canvaskit.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "tsx scripts/balance.ts",
    "export:web": "node scripts/copy-canvaskit.mjs && expo export --platform web",
    "e2e": "node scripts/e2e.mjs",
    "verify": "npm run typecheck && npm test && npm run balance -- --seed 1 --quiet"
  },
  "private": true
}

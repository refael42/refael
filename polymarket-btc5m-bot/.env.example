# Copy to .env and fill in. Never share .env or commit it.

# paper = practice with fake money against the real market (default)
# live  = real orders with real money
MODE=paper

# ─── Account (live mode only) ─────────────────────────────────────────
# Private key of the wallet that signs orders. On polymarket.com accounts
# created with email/Google: Settings → Export Private Key.
# Use a separate account holding only money you are ready to lose.
POLYMARKET_PRIVATE_KEY=
# Your Polymarket wallet address (profile menu → copy address)
POLYMARKET_WALLET_ADDRESS=
# Optional: lets the bot claim winnings by itself (Settings → API Keys →
# Relayer API Keys). Without it, click "Claim" on polymarket.com yourself.
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=

# ─── Strategy ─────────────────────────────────────────────────────────
# Markets: btc-updown-5m (also works with eth-updown-5m, sol-updown-5m, ...)
MARKET_PREFIX=btc-updown-5m
# Seconds after each 5-minute window opens to place the bet (0-299)
ENTRY_SECOND=120
# Only bet when the majority side is priced at least this (0.70 = 70% of the crowd)
MIN_CONFIDENCE=0.70
# Never pay more than this per share (a share pays $1 if right)
MAX_ENTRY_PRICE=0.95

# ─── How much to bet each time ("x") ──────────────────────────────────
# fraction   = BET_FRACTION of the balance every time
# confidence = BET_FRACTION * (crowd - 0.5) * 2 of the balance (more when the crowd is surer)
# fixed      = FIXED_BET_USD every time
STAKE_FORMULA=fraction
BET_FRACTION=0.02
FIXED_BET_USD=2
# Skip if the formula gives less than this; never bet more than MAX_BET_USD
MIN_BET_USD=1
MAX_BET_USD=10

# Market order may fill up to this much above the best ask
SLIPPAGE=0.02

# ─── Safety ───────────────────────────────────────────────────────────
# Stop for the rest of the day after losing this much (0 = no limit)
MAX_DAILY_LOSS_USD=20
# Stop when the balance drops to this
STOP_BELOW_BALANCE_USD=0

# Paper mode starting balance
PAPER_START_BALANCE=100
